{
  "rules": {
    ".read": false,
    "show": {
      "active": {
        ".read": true,
        ".write": "auth != null && auth.token.admin === true"
      },
      "currentCue": {
        ".read": true,
        ".write": "auth != null && auth.token.admin === true"
      }
    },
    "participants": {
      ".read": "auth != null && auth.token.admin === true",
      "$participantId": {
        ".write": "auth != null && auth.uid === $participantId && (!newData.exists() || root.child('show/active').val() === true)"
      }
    }
  }
}